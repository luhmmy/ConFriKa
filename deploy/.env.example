# Copy to deploy/.env and fill in. Never commit the real .env.
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
TURN_SECRET=

# ── Transactional email (Resend) ──────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Use the resend.dev sender until confrika.online is verified in Resend:
EMAIL_FROM=ConFriKa <onboarding@resend.dev>
# EMAIL_FROM=ConFriKa <noreply@confrika.online>

# ── Live in-call speech-to-speech translation (voice-preserving) ──────────
# elevenlabs.io (paid plan for real-time + voice cloning). Empty = stub mode.
VOICE_PROVIDER=elevenlabs
VOICE_API_KEY=
# VOICE_TTS_MODEL=eleven_turbo_v2_5
# VOICE_STT_MODEL=scribe_v1

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────
# Firebase console → project id + a Service Account JSON. Empty = stub mode.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# ── Production hardening ──────────────────────────────────────────────────
# APP_ENV=production
# ALLOWED_ORIGINS=https://confrika.online
# TURN_HOST=turn.confrika.online

# Admin dashboard access (comma-separated emails)
ADMIN_EMAILS=

# Optional: managed translation fallback for languages NLLB-200 does not
# cover (e.g. Tiv). Leave blank to run fully local on NLLB only.
GOOGLE_TRANSLATE_API_KEY=

# Monetization (ConFriKa Pro). Ads shown to free users; Pro removes them.
ADS_ENABLED=true
FREE_DAILY_TRANSLATIONS=30
FREE_DAILY_CALL_SECONDS=900
FREE_MAX_COMMUNITIES=2
# Google Play subscription verification (Android). Mount a Play service-account
# JSON and point to it here to verify purchases server-side.
PLAY_PACKAGE_NAME=com.confrika.confrika_mobile
PLAY_SERVICE_ACCOUNT_FILE=
PRO_PRODUCT_IDS=confrika_pro_monthly,confrika_pro_yearly
# Dev/testing only: grant Pro without server verification. MUST be false in prod.
BILLING_TRUST_UNVERIFIED=false
