# Copy to deploy/.env and fill in. Never commit the real .env.
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
TURN_SECRET=

# ── Transactional email (Resend) ──────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Use the resend.dev sender until confrika.online is verified in Resend:
EMAIL_FROM=ConFriKa <onboarding@resend.dev>
# EMAIL_FROM=ConFriKa <noreply@confrika.online>

# ── Live in-call speech-to-speech translation (voice-preserving) ──────────
# elevenlabs.io (paid plan for real-time + voice cloning). Empty = stub mode.
VOICE_PROVIDER=elevenlabs
VOICE_API_KEY=
# VOICE_TTS_MODEL=eleven_turbo_v2_5
# VOICE_STT_MODEL=scribe_v1

# ── Push notifications (Firebase Cloud Messaging) ─────────────────────────
# Firebase console → project id + a Service Account JSON. Empty = stub mode.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# ── Production hardening ──────────────────────────────────────────────────
# APP_ENV=production
# ALLOWED_ORIGINS=https://confrika.online
# TURN_HOST=turn.confrika.online
