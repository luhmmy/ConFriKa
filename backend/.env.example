# ConFriKa backend environment. Copy to .env and fill in real values.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
DEBUG=false

# REQUIRED in production — the app refuses to start without it.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL 16) and Redis 7
DATABASE_URL=postgresql+asyncpg://confrika_admin:CHANGE_ME@localhost:5432/confrika_prod
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# CORS — comma-separated allowed origins. Never use "*" in production.
ALLOWED_ORIGINS=https://app.confrika.com

# Translation engine (self-hosted NLLB-200, no API key required)
TRANSLATION_PROVIDER=nllb
NLLB_MODEL=facebook/nllb-200-distilled-600M
NLLB_DEVICE=cpu
MODEL_CACHE_DIR=/opt/confrika/models

# Pitch analysis bounds (Hz)
PITCH_ANALYSIS_MIN_F0=70.0
PITCH_ANALYSIS_MAX_F0=350.0

# WebRTC TURN relay (optional — leave TURN_HOST blank to use STUN only)
STUN_URL=stun:stun.l.google.com:19302
TURN_HOST=
TURN_PORT=3478
TURN_SECRET=
